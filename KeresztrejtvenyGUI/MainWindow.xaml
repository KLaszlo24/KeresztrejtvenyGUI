<Window x:Class="KeresztrejtvenyGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeresztrejtvenyGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
		<StackPanel Margin="10">

			<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
				<Label Content="Sorok:"/>
				<ComboBox x:Name="cbSor" Width="60" Margin="5"/>

				<Label Content="Oszlopok:" Margin="10,0,0,0"/>
				<ComboBox x:Name="cbOszlop" Width="60" Margin="5"/>

				<Button Content="Keresztrejtvény létrehozása"
						Click="Letrehozas_Click"
						Margin="10,0"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
				<Label Content="Index meghatározása: "/>
				<ComboBox x:Name="cbIndex" Width="60" Margin="5"/>

				<Button Content="Keresztrejtvény mentése"
                        Click="Mentes_Click"
                        Margin="10,0"/>
			</StackPanel>
			<ScrollViewer>
				<Grid x:Name="gridRacs"/>
			</ScrollViewer>

		</StackPanel>
	</Grid>
</Window>
